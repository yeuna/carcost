# Neon Postgres connection string (from the Vercel/Neon dashboard).
# Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The single password you'll type to log in.
APP_PASSWORD="change-me-to-something-strong"

# Random secret used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-long-random-string"

# --- Email service reminders (optional) ---
# Resend API key (https://resend.com → API Keys). Without it, no emails are sent.
RESEND_API_KEY=""
# Where reminder emails are sent.
NOTIFY_EMAIL="you@example.com"
# From address. Default works for sending to your own Resend account email.
# Set a verified-domain address to send anywhere. e.g. "CarCost <alerts@yourdomain.com>"
NOTIFY_FROM="CarCost <onboarding@resend.dev>"
# Protects the cron endpoint. Generate like AUTH_SECRET. Vercel sends this
# automatically to the scheduled job when set.
CRON_SECRET="generate-a-long-random-string"
# Your deployed app URL, used for the button in emails. e.g. https://carcost.vercel.app
APP_URL=""

# --- Backups (optional but recommended) ---
# Connecting a Vercel Blob store sets BLOB_STORE_ID automatically; on Vercel the
# backup job then authenticates via the platform's OIDC token (no static token
# needed). For local runs, `vercel env pull` brings these down. If neither
# BLOB_STORE_ID nor BLOB_READ_WRITE_TOKEN is set, scheduled backups are skipped
# (in-app download/restore still work).
BLOB_STORE_ID=""
# Optional: a static read-write token instead of OIDC (e.g. for non-Vercel hosts).
BLOB_READ_WRITE_TOKEN=""
# How many daily backups to keep in Blob before pruning the oldest. Default 30.
BACKUP_RETENTION_DAYS="30"
# The weekly emailed backup reuses RESEND_API_KEY / NOTIFY_EMAIL / NOTIFY_FROM above.
